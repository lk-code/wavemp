<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- snake_case names for tables, columns, keys and indexes (PostgreSQL convention). -->
    <PackageReference Include="EFCore.NamingConventions" />
    <!--
      Design-time only (dotnet ef). Compile assets are needed for WaveMpDesignTimeServices; PrivateAssets keeps the
      package out of the service and its image.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Lifts EF Core to the same patch version as the design-time package (Npgsql references an older one). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
