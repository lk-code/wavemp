{
  "name": "wavemp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . --deny-warnings && eslint . --max-warnings 0",
    "format": "prettier --write --experimental-cli .",
    "generate:api": "dotnet build ../WaveMP.Service/WaveMP.Service.csproj && dotnet tool restore && dotnet tool run kiota generate --language typescript --openapi ../WaveMP.Service/openapi.json --class-name WaveMpApiClient --output ./src/api/generated --clean-output --exclude-backward-compatible",
    "icons:sync": "node scripts/sync-icons.ts",
    "format:check": "prettier --check --experimental-cli ."
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "^1.0.0-preview.112",
    "@microsoft/kiota-bundle": "^1.0.0-preview.112",
    "@microsoft/kiota-http-fetchlibrary": "^1.0.0-preview.112",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@phosphor-icons/core": "2.1.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
