<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>wavemp-service</UserSecretsId>
    <!--
      Full globalization with ICU (Unicode normalization, culture-aware comparisons). Written to the
      runtimeconfig, where it takes precedence over DOTNET_SYSTEM_GLOBALIZATION_INVARIANT: without
      ICU the service fails at start instead of silently skipping the normalization.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Build-time OpenAPI document">
    <!-- Writes openapi.json next to this file on every non-Release build. Kiota generates the clients from it. -->
    <OpenApiGenerateDocuments Condition="'$(Configuration)' == 'Release'">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WaveMP.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaveMP.Core.Caching\WaveMP.Core.Caching.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Collection\WaveMP.Core.Collection.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Jobs\WaveMP.Core.Jobs.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Library\WaveMP.Core.Library.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Metadata\WaveMP.Core.Metadata.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Playlists\WaveMP.Core.Playlists.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Scanning\WaveMP.Core.Scanning.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Settings\WaveMP.Core.Settings.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Streaming\WaveMP.Core.Streaming.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Transcoding\WaveMP.Core.Transcoding.csproj" />
    <ProjectReference Include="..\WaveMP.Core.Users\WaveMP.Core.Users.csproj" />
    <ProjectReference Include="..\WaveMP.Data\WaveMP.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="openapi.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
