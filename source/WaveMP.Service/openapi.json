{
  "openapi": "3.1.1",
  "info": {
    "title": "WaveMP API",
    "description": "REST API of WaveMP, a nostalgic media player.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Returns the health of the service.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "The service is healthy or degraded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "At least one health check failed (code `health.unhealthy`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/settings": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "Returns the settings of the current profile.",
        "operationId": "GetMySettings",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The settings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          },
          "404": {
            "description": "The profile was deleted in the meantime (code `user.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "patch": {
        "tags": [
          "Me"
        ],
        "summary": "Changes the settings of the current profile. Missing or null values stay unchanged.",
        "operationId": "UpdateMySettings",
        "requestBody": {
          "description": "Aborts the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserSettings"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The changed settings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid (code `request.invalid`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The profile was deleted in the meantime (code `user.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/profiles": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Lists the profiles in the order they were created; the built-in admin profile comes last.",
        "operationId": "ListProfiles",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Number of profiles to skip.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of profiles of the page.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of profiles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters (code `request.invalid`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Selects a profile: creates a session and returns its token.",
        "operationId": "CreateSession",
        "requestBody": {
          "description": "Aborts the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The session with its token; Location points to the current session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedSession"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid (code `request.invalid`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The profile does not exist (code `profile.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/current": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Returns the session of the token, with its profile.",
        "operationId": "GetCurrentSession",
        "responses": {
          "200": {
            "description": "The current session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "No valid token, or the session has ended (code `auth.unauthorized`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Ends the session of the token (switching the profile); the token is no longer accepted.",
        "operationId": "DeleteCurrentSession",
        "responses": {
          "204": {
            "description": "The session has ended."
          },
          "401": {
            "description": "No valid token, or the session has ended (code `auth.unauthorized`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Lists the users, sorted and optionally filtered by role.",
        "operationId": "ListUsers",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Number of users to skip.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of users of the page.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort key; ties are sorted by id.",
            "schema": {
              "default": "Name",
              "$ref": "#/components/schemas/UserSort"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sort direction.",
            "schema": {
              "default": "Asc",
              "$ref": "#/components/schemas/SortDirection"
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "Only users with this role.",
            "schema": {
              "$ref": "#/components/schemas/Role"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "One page of users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters (code `request.invalid`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Creates a user. Missing initials are derived from the name, a missing color is the least used one.",
        "operationId": "CreateUser",
        "requestBody": {
          "description": "Aborts the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "The created user; Location points to it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid (code `request.invalid`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The name is taken (code `user.name_taken`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Returns a user.",
        "operationId": "GetUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the user.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "The user does not exist (code `user.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Changes a user. Missing or null values stay unchanged.",
        "operationId": "UpdateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the user.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Aborts the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUser"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The changed user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid (code `request.invalid`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The user does not exist (code `user.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (code `user.name_taken` or `user.built_in_admin`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Deletes a user with its settings and sessions.",
        "operationId": "DeleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the user.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "The user is deleted."
          },
          "404": {
            "description": "The user does not exist (code `user.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The built-in admin profile cannot be deleted (code `user.built_in_admin`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreatedSession": {
        "required": [
          "token",
          "session"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Bearer token of the session for the Authorization header."
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          }
        },
        "description": "A new session with its token."
      },
      "CreateSession": {
        "required": [
          "profileId"
        ],
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "description": "Id of the profile to select.",
            "format": "uuid"
          }
        },
        "description": "Selects a profile."
      },
      "CreateUser": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Name of the profile, unique without regard to case."
          },
          "initials": {
            "maxLength": 16,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "description": "Initials, 1 to 3 characters; derived from the name if missing or empty."
          },
          "color": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": [
              "null",
              "string"
            ],
            "description": "Color as #rrggbb; the least used color of the palette if missing."
          },
          "role": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Role; User if missing.",
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "description": "Creates a user (profile)."
      },
      "Health": {
        "required": [
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "description": "Aggregated status of all health checks.",
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "description": "Version of the running WaveMP service."
          }
        },
        "description": "Health of the WaveMP service."
      },
      "HealthStatus": {
        "enum": [
          "Healthy",
          "Degraded",
          "Unhealthy"
        ],
        "type": "string",
        "description": "Aggregated health status."
      },
      "Language": {
        "enum": [
          "en",
          "de"
        ],
        "type": "string",
        "description": "Language of the user interface."
      },
      "ProblemCode": {
        "enum": [
          "request.invalid",
          "request.not_found",
          "request.failed",
          "server.error",
          "service.unavailable",
          "health.unhealthy",
          "auth.unauthorized",
          "auth.forbidden",
          "profile.not_found",
          "user.not_found",
          "user.name_taken",
          "user.built_in_admin"
        ],
        "type": "string",
        "description": "Machine-readable code of a problem, part of every Problem Details response. Clients translate it."
      },
      "ProblemDetails": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          }
        }
      },
      "Profile": {
        "required": [
          "id",
          "name",
          "initials",
          "color",
          "role",
          "isBuiltIn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Name of the profile."
          },
          "initials": {
            "type": "string",
            "description": "Initials shown on the profile tile."
          },
          "color": {
            "type": "string",
            "description": "Color of the profile as #rrggbb."
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "isBuiltIn": {
            "type": "boolean",
            "description": "True for the built-in admin profile, which cannot be deleted and always stays an admin."
          }
        },
        "description": "A profile as shown in the profile selection."
      },
      "ProfilePage": {
        "required": [
          "items",
          "offset",
          "limit",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            },
            "description": "Items of the page, at most limit."
          },
          "offset": {
            "type": "integer",
            "description": "Number of items skipped before this page.",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of items of the page, as requested.",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "description": "Number of items of the whole collection.",
            "format": "int32"
          }
        },
        "description": "One page of a collection."
      },
      "Role": {
        "enum": [
          "Admin",
          "User"
        ],
        "type": "string",
        "description": "Role of a profile."
      },
      "Session": {
        "required": [
          "id",
          "profile",
          "createdAt",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "description": "The selected profile.",
            "$ref": "#/components/schemas/Profile"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "description": "When the session and its token expire.",
            "format": "date-time"
          }
        },
        "description": "A session of a profile."
      },
      "SortDirection": {
        "enum": [
          "Asc",
          "Desc"
        ],
        "type": "string",
        "description": "Sort direction."
      },
      "UpdateUser": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
